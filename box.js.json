{
  "id": "bingrewards.app.sub",
  "name": "Bing Rewards 订阅",
  "author": "@ygxdyz",
  "icon": "https://raw.githubusercontent.com/ygxdyz/Scripts/main/bing.png",
  "repo": "https://github.com/ygxdyz/Scripts",
  "apps": [
    {
      "id": "bingrewards",
      "name": "Bing Rewards",
      "icon": "https://raw.githubusercontent.com/ygxdyz/Scripts/main/bing.png",
      "keys": [
        "bingrewards_conf",
        "bingrewards_pass"
      ],
      "settings": [
        {
          "id": "bingrewards_conf",
          "name": "任务配置 (JSON)",
          "val": "",
          "type": "$text",
          "placeholder": "{\"per_run\":1}",
          "autoGrow": true,
          "desc": "per_run=每轮执行账号数（1=轮换模式，多号错峰；0或留空=每轮全跑）。enable_search/enable_quiz/enable_activities 填 false 可关对应任务。留空走脚本内联默认"
        },
        {
          "id": "bingrewards_pass",
          "name": "密码表 (可选, JSON数组)",
          "val": "",
          "type": "$text",
          "placeholder": "[{\"username\":\"a@outlook.com\",\"password\":\"pass\",\"otpauth\":\"\"}]",
          "autoGrow": true,
          "desc": "备选登录方式，数组支持多号；有两步验证填 otpauth 完整链接。捕获到的账号优先，与此表不冲突"
        }
      ],
      "author": "@ygxdyz",
      "repo": "https://github.com/ygxdyz/Scripts",
      "icons": [
        "https://raw.githubusercontent.com/ygxdyz/Scripts/main/bing.png",
        "https://raw.githubusercontent.com/ygxdyz/Scripts/main/bing.png"
      ]
    }
  ],
  "icons": [
    "https://raw.githubusercontent.com/ygxdyz/Scripts/main/bing.png",
    "https://raw.githubusercontent.com/ygxdyz/Scripts/main/bing.png"
  ]
}
